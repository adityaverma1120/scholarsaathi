# ==============================================================================
# ScholarSaathi — Environment Configuration Template (.env.example)
# Independent Prototype · Not a Government Service · Not affiliated with NSP
# Copy this file to .env.local for local development. NEVER commit .env.local!
# ==============================================================================

# ---- Secrets (Runtime, Server-Only — NEVER prefix with NEXT_PUBLIC_) ----
# LLM API configuration for intent classification & RAG support
AI_PROVIDER_KEY=your_llm_api_key_here
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-2-latest

# Optional PostgreSQL database connection string (Zero-DB mode runs by default if unset)
DATABASE_URL=

# ---- Server Configuration ----
MATCH_MODEL=grok-2-latest
AI_DAILY_CAP=2000
ALLOWED_ORIGIN=http://localhost:3000
PORT=3000

# ---- Public Configuration (Browser-Visible via NEXT_PUBLIC_) ----
NEXT_PUBLIC_APP_NAME="ScholarSaathi"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ---- Public Feature Flags (Baked at Build Time) ----
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_FEATURE_AI_MATCH=false
NEXT_PUBLIC_FEATURE_AI_ALWAYS=false
NEXT_PUBLIC_FEATURE_OCR=false
NEXT_PUBLIC_FEATURE_OCR_SERVER=false
NEXT_PUBLIC_FEATURE_VOICE_INPUT=false
NEXT_PUBLIC_FEATURE_AI_GRIEVANCE=false
NEXT_PUBLIC_FEATURE_AI_DASHBOARD=false
NEXT_PUBLIC_FEATURE_WHY_LINE=false
NEXT_PUBLIC_FEATURE_GRIEVANCE=true
NEXT_PUBLIC_FEATURE_DASHBOARD=true
